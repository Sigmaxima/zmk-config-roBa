            require-prior-idle-ms = <300>;
            layers = <3>;
        };

        combo_window_spin_move {
            bindings = <&kp LS(LG(LEFT))>;
            key-positions = <21 17>;
            require-prior-idle-ms = <200>;
            layers = <3>;
        };

        combo_search_in_browser {
            bindings = <&macro_copy_search_in_app>;
            key-positions = <28 16>;
            require-prior-idle-ms = <300>;
            layers = <0>;
            timeout-ms = <300>;
        };

        combo_ctrl_left {
            bindings = <&kp LC(LEFT)>;
            key-positions = <18 19>;
            layers = <3>;
        };

        combo_ctrl_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <19 20>;
            layers = <3>;
        };

        combo_f2 {
            bindings = <&kp F2>;
            key-positions = <1 0>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_f3 {
            bindings = <&kp F3>;
