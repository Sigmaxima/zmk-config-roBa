    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q                 &mat_home_end_select HOME W  &mat_select_line 0 E       &mat_home_end_select END R        &mat_emacs 0 T                                                                              &mat_tripleclick 0 Y             &mat_tripleclick 0 U      &mt_tap_preferred LS(N8) I             &mt_tap_preferred LS(N9) O         &kp MINUS
&mt_long_press LCTRL A       &mt_long_press LEFT_SHIFT S  &mt_long_press LEFT_ALT D  &mt_long_press LEFT_CONTROL F     &mt_long_press LEFT_GUI G    &none                                 &mat_mb5 0 LEFT_BRACKET  &mat_doubleclick 0 H             &mat_mb1 0 J              &lt 5 K                                &mat_mb2 0 L                       &mt_long_press RCTRL P
&mt_long_press LEFT_SHIFT Z  &kp X                        &kp C                      &kp V                             &kp B                        &kp SEMI                              &mat_mb4 0 SQT           &mt_tap_preferred RIGHT_BRACE N  &mt_tap_preferred PIPE M  &mt_tap_preferred RIGHT_BRACKET COMMA  &mt_tap_preferred NON_US_HASH DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL                    &kp LEFT_WIN                 &kp LEFT_ALT               &lt_to_layer_0 7 INTERNATIONAL_5  &lt_holdprefferd_qt 2 SPACE  &lt_to_layer_0 6 INTERNATIONAL_4      &kp BACKSPACE            &lt_to_layer_0 3 RET                                                                                                                 &mo 5
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        APPLE {
            bindings = <
&trans                     &trans     &trans  &trans                     &trans                                           &trans                  &trans                      &trans  &trans  &trans
&mt_long_press LEFT_GUI A  &trans     &trans  &mt_long_press LEFT_GUI F  &trans  &trans                           &trans  &trans                  &mt_long_press RIGHT_GUI J  &trans  &trans  &mt_long_press RIGHT_GUI P
&trans                     &trans     &trans  &trans                     &trans  &trans                           &trans  &trans                  &trans                      &trans  &trans  &trans
&kp LEFT_GUI               &kp LCTRL  &trans  &kp LANGUAGE_2             &trans  &lt_to_layer_1 8 LANGUAGE_1      &trans  &lt_to_layer_1 3 ENTER                                              &mt_long_press RIGHT_GUI INTERNATIONAL_1
            >;
        };

        NUM_BAR_SYMBOLS {
            bindings = <
&kp EXCLAMATION       &kp LS(N2)  &mat_inset_at_head HASH HASH  &kp DOLLAR    &kp PERCENT                                          &kp LS(NUMBER_6)          &kp LS(N7)             &mat_parenthesis 0 LS(N8)     &kp LS(N9)          &kp LS(EQUAL)
&kp N1                &kp N2      &kp N3                        &kp N4        &kp N5       &trans         &kp DOT                  &kp N6                    &mat_select_line 0 N7  &mat_emacs 0 N8               &mat_cut_line 0 N9  &kp N0
&mt LEFT_SHIFT SLASH  &kp MINUS   &kp LS(SQT)                   &kp LS(SEMI)  &kp DOT      &kp EQUAL      &kp LS(INTERNATIONAL_3)  &mat_brace 0 RIGHT_BRACE  &kp PIPE               &mat_bracket 0 RIGHT_BRACKET  &mt NUHS DOT        &trans
&trans                &trans      &trans                        &trans        &trans       &trans         &kp DELETE               &trans                                                                                             &kp INT1
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        NUM_ARROW {
            bindings = <
&trans          &mat_home_end_select HOME HOME  &macro_select_line  &mat_home_end_select END END  &macro_emacs_k_cut_to_end                                     &trans   &mt LC(LS(TAB)) LC(PAGE_UP)     &kp UP_ARROW  &mt LC(TAB) LC(PAGE_DOWN)     &kp ESC
&kp LCTRL       &kp LEFT_SHIFT                  &kp LEFT_ALT        &kp LCTRL                     &kp LEFT_GUI               &trans      &mama_serch 0 0        &trans   &kp LEFT                        &kp DOWN      &kp RIGHT                     &kp RCTRL
&kp LEFT_SHIFT  &trans                          &trans              &trans                        &trans                     &trans      &macro_delete_at_head  &kp TAB  &mat_home_end_select HOME HOME  &kp RSHIFT    &mat_home_end_select END END  &kp RIGHT_SHIFT
&trans          &trans                          &trans              &kp LS(TAB)                   &kp TAB                    &trans      &kp DELETE             &trans                                                                               &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        MOUSE {
            bindings = <
&macro_kp_lo Q  &macro_kp_lo W  &macro_kp_lo E  &macro_kp_lo R  &macro_kp_lo T                                                          &macro_kp_lo Y    &macro_kp_lo U  &macro_kp_lo I  &macro_kp_lo O  &macro_kp_lo MINUS
&macro_kp_lo A  &macro_kp_lo S  &macro_kp_lo D  &macro_kp_lo F  &macro_kp_lo G      &trans                      &macro_kp_lo LBKT       &macro_kp_lo H    &mkp MB1        &mo 5           &mkp MB2        &kp RCTRL
&macro_kp_lo Z  &macro_kp_lo X  &macro_kp_lo C  &macro_kp_lo V  &macro_kp_lo B      &macro_kp_lo LS(MINUS)      &macro_kp_lo LS(N3)     &macro_kp_lo N    &mkp MB4        &kp RCTRL       &mkp MB5        &kp RIGHT_SHIFT
&trans          &trans          &trans          &trans          &macro_kp_lo SPACE  &trans                      &macro_kp_lo BACKSPACE  &macro_kp_lo RET                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        BT_SCROLL {
            bindings = <
&trans             &trans            &trans            &trans            &trans                                                              &trans           &macro_k_helper U  &macro_k_helper I  &macro_k_helper O  &trans
&macro_k_helper A  &trans            &trans            &trans            &trans               &trans                 &kp LS(LG(RIGHT))       &trans           &mkp MB1           &trans             &mkp MB2           &kp LCTRL
&macro_bt_0_to 0   &macro_bt_1_to 0  &macro_bt_2_to 1  &macro_bt_3_to 0  &macro_bt_4_to 0     &trans                 &kp LS(LG(LEFT_ARROW))  &kp LC(T)        &mkp MB4           &kp LC(W)          &mkp MB5           &trans
&to 0              &to 1             &to 11            &trans            &kp LC(LA(LS(TAB)))  &kp LS(LG(RIGHT))      &kp LC(LS(LA(TAB)))     &kp LC(LA(TAB))                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(MINUS) LS(LC(MINUS))>;
        };

        FUNCTION_APPLICATION {
            bindings = <
&kp C_PREV  &kp C_STOP  &kp C_PP  &kp C_NEXT  &kp C_MUTE                                                                    &macro_calculator                    &macro_word         &macro_excel      &macro_powerpoint     &macro_capture
&kp F1      &kp F2      &kp F3    &kp F4      &kp F5      &trans                       &mama_serch 0 0                      &macro_copy_url                      &mama_explorer 0 0  &macro_teams      &macro_outlook        &macro_browser
&kp F6      &kp F7      &kp F8    &kp F9      &kp F10     &mt LG(LA(K)) LC(LS(M))      &mama_music_apps 0 0                 &trans                               &mama_onenote 0 0   &mama_vscode 0 0  &mama_texteditor 0 0  &macro_todo
&kp F11     &kp F12     &kp F13   &trans      &trans      &trans                       &macro_bat_and_return LC(LA(LS(T)))  &macro_bat_and_return LC(LA(LS(P)))                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        TEXT_EDIT {
            bindings = <
&kp LC(N1)           &kp LC(N2)           &kp LC(N3)           &kp LC(N4)      &kp LC(N0)                                 &trans  &macro_text_deco U  &kp LS(LA(UP))      &macro_text_deco N  &trans
&kp LC(LA(N1))       &kp LC(LA(N2))       &kp LC(LA(N3))       &kp LC(LA(N4))  &kp LC(LA(N0))  &trans             &trans  &trans  &kp LS(LA(LEFT))    &kp LS(LA(DOWN))    &kp LS(LA(RIGHT))   &trans
&trans               &trans               &kp LS(LC(C))        &kp LS(LC(V))   &kp LC(B)       &kp LS(LC(H))      &trans  &trans  &macro_text_color   &macro_text_deco H  &kp LC(DOT)         &kp LC(FSLH)
&macro_text_align L  &macro_text_align C  &macro_text_align R  &trans          &trans          &trans             &trans  &trans                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LS(PERIOD)) LC(LS(COMMA))>;
        };

        TEN_KEYS {
            bindings = <
&trans        &kp N7  &kp N8        &kp N9  &trans                               &kp FSLH     &kp N7  &kp N8  &kp N9  &kp MINUS
&trans        &kp N4  &kp N5        &kp N6  &kp UP    &trans      &kp LS(MINUS)  &kp LS(SQT)  &kp N4  &kp N5  &kp N6  &kp LS(SEMICOLON)
&kp LS(PLUS)  &kp N1  &kp NUMBER_2  &kp N3  &kp DOWN  &trans      &kp DOT        &kp N0       &kp N1  &kp N2  &kp N3  &kp DOT
&trans        &kp N0  &kp DOT       &kp N0  &kp N0    &trans      &trans         &kp N0                               &kp DOT
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        GAME {
            bindings = <
&kp CAPS   &kp Q    &kp W         &kp E   &kp R                                 &trans                &trans  &trans  &trans  &trans
&kp TAB    &kp A    &kp S         &kp D   &kp F      &trans      &trans         &trans                &trans  &kp K   &trans  &trans
&kp LSHFT  &kp Z    &kp X         &kp C   &kp V      &kp G       &kp DELETE     &trans                &trans  &trans  &trans  &trans
&kp LCTRL  &kp ESC  &kp LEFT_ALT  &mo 10  &kp SPACE  &kp B       &kp BACKSPACE  &lt_to_layer_0 3 RET                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        GAME_SHIFT {
            bindings = <
&trans  &trans  &trans  &trans  &kp T                       &trans  &trans  &trans  &trans  &trans
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        APPLICATION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
