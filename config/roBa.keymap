            bindings = <&kp INT_MUHENKAN &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp SPACE>;
            label = "MACRO_ASCII_TYPE_SPACE";
        };

        macro_browser: macro_browser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp H &kp T &kp T &kp P &kp SQT &kp FSLH &kp FSLH &kp ENTER>;

            label = "MACRO_BROWSER";
        };

        macro_calculator: macro_calculator {
