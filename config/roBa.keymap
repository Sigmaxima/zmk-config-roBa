            key-positions = <11 12>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <12 13>;
            require-prior-idle-ms = <100>;
            layers = <0>;
            timeout-ms = <300>;
        };

        combo_win_v {
            bindings = <&kp LG(V)>;
            key-positions = <13 14>;
            require-prior-idle-ms = <100>;
            layers = <0>;
            timeout-ms = <300>;
        };

        combo_paste_plain_text {
            bindings = <&macro_plain_text>;
            key-positions = <24 25>;
            require-prior-idle-ms = <200>;
            layers = <0>;
            timeout-ms = <200>;
        };

        combo_capslock {
            bindings = <&kp LS(CAPS)>;
            key-positions = <0 34>;
            require-prior-idle-ms = <200>;
            layers = <0>;
            timeout-ms = <300>;
        };

        combo_printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <34 42>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_teams_rich_textbox {
            bindings = <&kp LC(LS(X))>;
            key-positions = <0 9>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_teams_mic {
            bindings = <&kp LS(LC(M))>;
            key-positions = <>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_alt_f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <9 42>;
            layers = <0>;
            require-prior-idle-ms = <800>;
            timeout-ms = <250>;
        };

        combo_search {
            bindings = <&macro_copy_search_internet>;
            key-positions = <28 16>;
            layers = <3>;
        };

        combo_ctrl_a {
            bindings = <&kp LC(A)>;
            key-positions = <0 10>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_triple_click {
            bindings = <&macro_tripleclick>;
            key-positions = <19 17>;
