#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    quick-tap-ms = <300>;
    tapping-term-ms = <150>;
};

&lt { tapping-term-ms = <120>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_mb1 {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
            timeout-ms = <300>;
            layers = <0 4 5>;
            require-prior-idle-ms = <50>;
        };

        combo_mb2 {
            bindings = <&mkp MB2>;
            key-positions = <20 19>;
            timeout-ms = <200>;
            layers = <4 5 0>;
            require-prior-idle-ms = <150>;
        };

        combo_mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 20>;
            timeout-ms = <200>;
            layers = <0 4 5>;
            require-prior-idle-ms = <250>;
        };

        combo_mb2_e {
            bindings = <&macro_mb2_e>;
            key-positions = <20 21>;
            timeout-ms = <300>;
            layers = <4 5>;
            require-prior-idle-ms = <100>;
        };

        combo_tog_tenkeys {
            bindings = <&tog 7>;
            key-positions = <6 7 8>;
            layers = <0 7>;
        };

        combo_tog_game_mode {
            bindings = <&tog 8>;
            key-positions = <1 2 3>;
            layers = <0 8>;
        };

        combo_search_in_browser {
            bindings = <&macro_copy_search_in_app>;
            key-positions = <28 16>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_move_window {
            bindings = <&macro_move_window>;
            key-positions = <6 8>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_resize_windows_rd {
            bindings = <&macro_resize_windows_rd>;
            key-positions = <17 29>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_resize_window_ul {
            bindings = <&macro_resize_window_ul>;
            key-positions = <5 17>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_max_windows {
            bindings = <&kp LG(UP_ARROW)>;
            key-positions = <20 21>;
            require-prior-idle-ms = <300>;
            layers = <0>;
            timeout-ms = <80>;
        };

        combo_min_window {
            bindings = <&kp LG(DOWN)>;
            key-positions = <33 32>;
            require-prior-idle-ms = <300>;
            layers = <0>;
            timeout-ms = <80>;
        };

        combo_repop_window {
            bindings = <&kp LA(TAB)>;
            key-positions = <32 42>;
            timeout-ms = <80>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_right_window {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <9 21>;
            require-prior-idle-ms = <300>;
            layers = <0>;
            timeout-ms = <80>;
        };

        combo_left_window {
            bindings = <&kp LG(LEFT)>;
            key-positions = <21 33>;
            require-prior-idle-ms = <300>;
            layers = <0>;
            timeout-ms = <80>;
        };

        combo_window_lists {
            bindings = <&kp LC(LA(TAB))>;
            key-positions = <29 33>;
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_window_spin_move {
            bindings = <&kp LS(LG(LEFT))>;
            key-positions = <5 9>;
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_ctrl_left {
            bindings = <&kp LC(LEFT)>;
            key-positions = <18 19>;
            layers = <3>;
        };

        combo_ctrl_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <19 20>;
            layers = <3>;
        };

        combo_f2 {
            bindings = <&kp F2>;
            key-positions = <1 0>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_f3 {
            bindings = <&kp F3>;
            key-positions = <3 4>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_f5 {
            bindings = <&kp F5>;
            key-positions = <5 6>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_f11 {
            bindings = <&kp F11>;
            key-positions = <8 9>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_doublequate {
            bindings = <&kp LS(N2)>;
            key-positions = <30 31>;
            layers = <0>;
        };

        combo_singlequate {
            bindings = <&kp LS(N7)>;
            key-positions = <>;
            layers = <0>;
        };

        combo_underscore {
            bindings = <&kp LS(INTERNATIONAL_1)>;
            key-positions = <32 31>;
            layers = <0>;
        };

        combo_ctrl_z {
            bindings = <&kp LC(Z)>;
            key-positions = <22 23>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <23 24>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <11 12>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <12 13>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_win_v {
            bindings = <&kp LG(V)>;
            key-positions = <13 14>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_paste_plane_text {
            bindings = <&macro_plane_text>;
            key-positions = <24 25>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_capslock {
            bindings = <&kp LS(CAPS)>;
            key-positions = <0 9>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <34 42>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_teams_rich_textbox {
            bindings = <&kp LC(LS(X))>;
            key-positions = <10 21>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_teams_mic {
            bindings = <&kp LS(LC(M))>;
            key-positions = <>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_alt_f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <9 42>;
            layers = <0>;
            require-prior-idle-ms = <1000>;
            timeout-ms = <50>;
        };

        combo_search {
            bindings = <&macro_copy_search_internet>;
            key-positions = <28 16>;
            layers = <3>;
        };

        combo_ctrl_a {
            bindings = <&kp LC(A)>;
            key-positions = <0 10>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        combo_select_line {
            bindings = <&macro_select_line>;
            key-positions = <30 32>;
            require-prior-idle-ms = <300>;
            layers = <0 3>;
        };

        combo_triple_click {
            bindings = <&macro_triple_click>;
            key-positions = <19 17>;
            timeout-ms = <300>;
            require-prior-idle-ms = <50>;
            layers = <0 4 5>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        macro_emacs_k_cut_to_end: macro_emacs_k_cut_to_end {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT &kp END &kt LEFT_SHIFT &kp LC(X)>;
            label = "MACRO_EMACS_K_CUT_TO_END";
        };

        macro_insert_at_head: macro_insert_at_head {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp INTERNATIONAL_5 &kt LEFT_SHIFT &kp HOME &kt LEFT_SHIFT &kp LC(X) &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp SPACE &kp LC(V)>;
            label = "MACRO_INSERT_AT_HEAD";
        };

        macro_delete_at_head: macro_delete_at_head {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_5 &kt LEFT_SHIFT &kp HOME &kp RIGHT &kp RIGHT &kt LSHFT &kp LC(X) &kp BACKSPACE &kp BACKSPACE &kp LC(V)>;
            label = "MACRO_DELETE_AT_HEAD";
        };

        macro_home_end_select: macro_home_end_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kt LEFT_SHIFT &macro_param_1to1 &kp MACRO_PLACEHOLDER &kt LEFT_SHIFT &kp LC(C)>;
            label = "MACRO_HOME_END_SELECT";
        };

        macro_browser: macro_browser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp H &kp T &kp T &kp P &kp SQT &kp FSLH &kp FSLH &kp ENTER>;

            label = "MACRO_BROWSER";
        };

        macro_mb2_e: macro_mb2_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB2 &kp E &kp DOWN_ARROW>;
            label = "MACRO_MB2_E";
        };

        macro_calculator: macro_calculator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp C &kp A &kp L &kp C &kp ENTER>;

            label = "MACRO_CALCULATOR";
        };

        macro_onenote: macro_onenote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp O &kp N &kp E &kp N &kp O &kp T &kp E &kp ENTER>;

            label = "MACRO_ONENOTE";
        };

        macro_teams: macro_teams {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp M &kp S &kp MINUS &kp T &kp E &kp A &kp M &kp S &kp ENTER>;

            label = "MACRO_TEAMS";
        };

        macro_outlook: macro_outlook {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp O &kp U &kp T &kp L &kp O &kp O &kp K &kp ENTER>;

            label = "MACRO_OUTLOOK";
        };

        macro_word: macro_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp W &kp I &kp N &kp W &kp O &kp R &kp D &kp ENTER>;

            label = "MACRO_WORD";
        };

        macro_excel: macro_app_excel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp E &kp X &kp C &kp E &kp L &kp ENTER>;

            label = "MACRO_APP_EXCEL";
        };

        macro_powerpoint: macro_powerpoint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp P &kp O &kp W &kp E &kp R &kp P &kp N &kp T &kp ENTER>;

            label = "MACRO_POWERPOINT";
        };

        macro_capture: macro_capture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp S &kp N &kp I &kp P &kp P &kp I &kp N &kp G &kp T &kp O &kp O &kp L &kp ENTER>;

            label = "MACRO_CAPTURE";
        };

        macro_itunes: macro_itunes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp I &kp T &kp U &kp N &kp E &kp S &kp ENTER>;

            label = "MACRO_ITUNES";
        };

        macro_vscode: macro_vscode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp C &kp O &kp D &kp E &kp ENTER>;

            label = "MACRO_VSCODE";
        };

        macro_notepad: macro_notepad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp N &kp O &kp T &kp E &kp P &kp A &kp D &kp ENTER>;

            label = "MACRO_NOTEPAD";
        };

        macro_hidemaru: macro_hidemaru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(C) &kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp H &kp I &kp D &kp E &kp M &kp A &kp R &kp U &kp ENTER>,
                <&macro_wait_time 200>,
                <&kp LC(V)>;

            label = "MACRO_HIDEMARU";
        };

        macro_audirvana: macro_audirvana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp A &kp U &kp D &kp I &kp R &kp V &kp A &kp N &kp A &kp ENTER>;

            label = "MACRO_AUDIRVANA";
        };

        macro_todo: macro_todo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp T &kp O &kp D &kp O &kp ENTER>;

            label = "MACRO_TODO";
        };

        macro_copy_search_in_app: macro_copy_search_in_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C) &kp LC(E) &kp LC(V) &kp ENTER>;
            label = "MACRO_COPY_SEARCH_IN_APP";
        };

        macro_move_window: macro_move_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LA(SPACE)>,
                <&macro_wait_time 150>,
                <&kp M &kp UP_ARROW &kp DOWN_ARROW>;

            label = "MACRO_MOVE_WINDOW";
        };

        macro_resize_window_ul: macro_resize_window_ul {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LA(SPACE)>,
                <&macro_wait_time 150>,
                <&kp S &kp LEFT_ARROW &kp UP_ARROW>;

            label = "MACRO_RESIZE_WINDOW_UL";
        };

        macro_resize_windows_rd: macro_resize_windows_rd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LA(SPACE)>,
                <&macro_wait_time 150>,
                <&kp S &kp RIGHT &kp DOWN_ARROW>;

            label = "MACRO_RESIZE_WINDOWS_RD";
        };

        macro_copy_search_internet: macro_copy_search_internet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(C) &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp H &kp T &kp T &kp P &kp S &kp SQT &kp FSLH &kp FSLH &kp G &kp O &kp O &kp G &kp L &kp E &kp DOT &kp C &kp O &kp M &kp FSLH &kp S &kp E &kp A &kp R &kp C &kp H &kp LS(SLASH) &kp Q &kp LS(MINUS) &kp LC(V) &kp ENTER>;

            label = "MACRO_COPY_SEARCH_INTERNET";
        };

        macro_ascii_type: macro_ascii_type {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp INT_MUHENKAN &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MACRO_ASCII_TYPE";
        };

        macro_ascii_type_space: macro_ascii_type_space {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp INT_MUHENKAN &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp SPACE>;
            label = "MACRO_ASCII_TYPE_SPACE";
        };

        macro_plane_text: macro_plane_text {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(V)>,
                <&macro_wait_time 450>,
                <&kp LCTRL &kp TAB>,
                <&macro_wait_time 150>,
                <&kp LCTRL &kp ENTER>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp ENTER>;

            label = "MACRO_PLANE_TEXT";
        };

        macro_onenote_quicknote: macro_onenote_quicknote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(N))>;
            label = "MACRO_ONENOTE_QUICKNOTE";
        };

        macro_open_in_vscode: macro_open_in_vscode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp K_CMENU &kp RCTRL>,
                <&macro_wait_time 400>,
                <&kp RCTRL &kp UP_ARROW &kp ENTER>,
                <&macro_wait_time 250>,
                <&kp RCTRL &kp C>;

            label = "MACRO_OPEN_IN_VSCODE";
        };

        macro_plane_text_command: macro_plane_text_command {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(P)))>, <&macro_wait_time 300>, <&kp LC(V)>;

            label = "MACRO_PLANE_TEXT_COMMAND";
        };

        macro_open_in_sharepoint: macro_open_in_sharepoint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp K_CMENU &kp RCTRL>,
                <&macro_wait_time 400>,
                <&kp RCTRL &kp UP_ARROW &kp ENTER>,
                <&macro_wait_time 250>,
                <&kp RCTRL &kp V &kp V &kp ENTER>;

            label = "MACRO_OPEN_IN_SHAREPOINT";
        };

        macro_explorer: macro_explorer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(E)>;
            label = "MACRO_EXPLORER";
        };

        macro_select_line: macro_select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kt LEFT_SHIFT &kp END &kt LEFT_SHIFT>;
            label = "MACRO_SELECT_LINE";
        };

        macro_triple_click: macro_triple_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB1 &mkp MB1 &mkp MB1>;
            label = "MACRO_TRIPLE_CLICK";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "SCROLL_UP_DOWN";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };

        mt_tap_preferred: mt_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mt_long_press: mt_long_press {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_LONG_PRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
            retro-tap;
            require-prior-idle-ms = <120>;
        };

        mat_emacs: mat_emacs {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_EMACS";
            bindings = <&macro_emacs_k_cut_to_end>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mat_ascii_type: mat_ascii_type {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_ASCII_TYPE";
            bindings = <&macro_ascii_type>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mat_ascii_space: mat_ascii_space {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_ASCII_SPACE";
            bindings = <&macro_ascii_type_space>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mat_ascii_type_reverse: mat_ascii_type_reverse {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_ASCII_TYPE_REVERSE";
            bindings = <&kp>, <&macro_ascii_type>;

            #binding-cells = <2>;
            tapping-term-ms = <80>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <25>;
        };

        mat_inset_at_head: mat_inset_at_head {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_INSET_AT_HEAD";
            bindings = <&macro_insert_at_head>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mat_home_end_select: mat_home_end_select {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_HOME_END_SELECT";
            bindings = <&macro_home_end_select>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mama_music_apps: mama_music_apps {
            compatible = "zmk,behavior-hold-tap";
            label = "MAMA_MUSIC_APPS";
            bindings = <&macro_audirvana>, <&macro_itunes>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "tap-preferred";
        };

        mama_onenote: mama_onenote {
            compatible = "zmk,behavior-hold-tap";
            label = "MAMA_ONENOTE";
            bindings = <&macro_onenote>, <&macro_onenote_quicknote>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        mama_texteditor: mama_texteditor {
            compatible = "zmk,behavior-hold-tap";
            label = "MAMA_TEXTEDITOR";
            bindings = <&macro_hidemaru>, <&macro_notepad>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        mama_vscode: mama_vscode {
            compatible = "zmk,behavior-hold-tap";
            label = "MAMA_VSCODE";
            bindings = <&macro_open_in_vscode>, <&macro_vscode>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        mama_explorer: mama_explorer {
            compatible = "zmk,behavior-hold-tap";
            label = "MAMA_EXPLORER";
            bindings = <&macro_open_in_sharepoint>, <&macro_explorer>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        lt_holdprefferd_qt: lt_holdprefferd_qt {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLDPREFFERD_QT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q            &kp W                        &kp E                      &kp R                             &kp T                                                                                                                    &kp Y                 &kp U                           &kp I        &kp O                         &kp MINUS
&mt_long_press LCTRL A  &mt_long_press LEFT_SHIFT S  &mt_long_press LEFT_ALT D  &mt_long_press LEFT_CONTROL F     &kp G                        &none                                    &mat_ascii_type_reverse LEFT_BRACKET LEFT_BRACKET  &kp H                 &mt_long_press RIGHT_CONTROL J  &lt 5 K      &mt_long_press RIGHT_SHIFT L  &mt_long_press RCTRL P
&mt LEFT_SHIFT Z        &kp X                        &kp C                      &kp V                             &kp B                        &mat_ascii_type LS(MINUS) LS(MINUS)      &mat_inset_at_head LS(N3) LS(N3)                   &kp N                 &kp M                           &lt 4 COMMA  &kp DOT                       &mt RIGHT_SHIFT SLASH
&kp LCTRL               &kp LEFT_WIN                 &kp LEFT_ALT               &lt_to_layer_0 6 INTERNATIONAL_5  &lt_holdprefferd_qt 2 SPACE  &lt_to_layer_0 1 INTERNATIONAL_4         &kp BACKSPACE                                      &lt_to_layer_0 3 RET                                                                             &mt_long_press RCTRL INT1
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        FUNCTION_APPLICATION {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4  &kp F5                                     &macro_calculator  &macro_word         &macro_excel      &macro_powerpoint     &macro_capture
&kp F6   &kp F7   &kp F8   &kp F9  &kp F10  &trans      &mama_music_apps 0 0  &kp C_MUTE         &mama_explorer 0 0  &macro_teams      &macro_outlook        &macro_browser
&kp F11  &kp F12  &kp F13  &trans  &trans   &trans      &kp C_PREVIOUS        &kp C_NEXT         &mama_onenote 0 0   &mama_vscode 0 0  &mama_texteditor 0 0  &macro_todo
&trans   &trans   &trans   &trans  &trans   &trans      &kp C_STOP            &kp C_PLAY_PAUSE                                                               &macro_copy_search_internet
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        SYMBOLS {
            bindings = <
&kp EXCLAMATION       &kp LS(N2)  &mat_inset_at_head HASH HASH  &kp DOLLAR  &kp PERCENT                                   &kp LS(NUMBER_6)  &kp LS(N7)         &mat_ascii_type LS(N8) LS(N8)  &mat_ascii_type LS(N9) LS(N9)  &kp EQUAL
&kp LC(A)             &kp LC(S)   &kp LS(LEFT_BRACKET)          &kp LC(F)   &kp LS(EQUAL)  &trans             &kp MINUS   &kp RIGHT_BRACE   &kp PIPE           &mat_emacs 0 SEMI              &mat_ascii_space SQT SQT       &mat_inset_at_head LS(INTERNATIONAL_3) LS(INTERNATIONAL_3)
&mt LEFT_SHIFT LC(Z)  &kp LC(X)   &kp LC(C)                     &kp LC(V)   &kp LC(B)      &kp LS(LC(M))      &kp SLASH   &kp LS(SQT)       &kp LS(SEMICOLON)  &kp RIGHT_BRACKET              &kp NUHS                       &mt RIGHT_SHIFT LS(SLASH)
&trans                &trans      &trans                        &trans      &trans         &trans             &kp DELETE  &trans                                                                                             &kp LS(INT1)
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        ARROW_NUM {
            bindings = <
&mat_ascii_type_reverse N1 N1  &mat_ascii_type_reverse N2 N2  &mat_ascii_type_reverse N3 N3  &mat_ascii_type_reverse N4 N4  &mat_ascii_type_reverse N5 N5                                                                    &trans   &kp LC(PAGE_UP)                 &kp UP_ARROW    &kp LC(PAGE_DOWN)             &kp ESC
&mat_ascii_type_reverse N6 N6  &mat_ascii_type_reverse N7 N7  &mat_ascii_type_reverse N8 N8  &mat_ascii_type_reverse N9 N9  &mat_ascii_type_reverse N0 N0    &trans                                   &macro_delete_at_head  &trans   &kp LEFT                        &kp DOWN        &kp RIGHT                     &kp RCTRL
&mt LEFT_SHIFT KP_DIVIDE       &kp KP_ASTERISK                &kp KP_MINUS                   &kp KP_PLUS                    &mat_ascii_type_reverse DOT DOT  &mat_ascii_type LS(MINUS) LS(MINUS)      &kp DELETE             &kp TAB  &mat_home_end_select HOME HOME  &kp DOWN_ARROW  &mat_home_end_select END END  &kp RIGHT_SHIFT
&trans                         &trans                         &trans                         &kp LS(TAB)                    &kp TAB                          &trans                                   &kp DELETE             &trans                                                                                 &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mo 5   &mkp MB2  &kp RCTRL
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &kp RIGHT_SHIFT
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        SCROLL {
            bindings = <
&kp LA(F4)  &kp LG(LS(LEFT))  &kp LG(UP_ARROW)    &kp LG(LS(RIGHT))        &kp LG(D)                                                                 &trans           &kp LC(LS(TAB))  &none      &kp LC(TAB)  &trans
&trans      &kp LG(LEFT)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT)            &trans              &trans                        &trans                  &trans           &mkp MB1         &trans     &mkp MB2     &kp RCTRL
&trans      &trans            &kp LG(TAB)         &trans                   &trans              &mo 11                        &trans                  &kp LC(T)        &mkp MB4         &kp LC(W)  &mkp MB5     &kp RIGHT_SHIFT
&trans      &trans            &trans              &macro_resize_window_ul  &macro_move_window  &macro_resize_windows_rd      &kp LS(LG(LEFT_ARROW))  &kp LC(LA(TAB))                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(MINUS) LS(LC(MINUS))>;
        };

        TEXT_EDIT {
            bindings = <
&kp LC(N1)      &kp LC(N2)        &kp LC(N3)      &kp LC(N4)         &kp LC(N0)                                     &kp LS(NUMBER_6)  &kp LS(N7)         &mat_ascii_type LS(N8) LS(N8)  &mat_ascii_type LS(N9) LS(N9)  &kp EQUAL
&kp LC(LA(N1))  &kp LC(LA(N2))    &kp LC(LA(N3))  &kp LC(LA(N4))     &kp LC(LA(N0))  &trans             &kp MINUS   &kp RIGHT_BRACE   &kp PIPE           &mat_emacs 0 SEMI              &mat_ascii_space SQT SQT       &mat_inset_at_head LS(INTERNATIONAL_3) LS(INTERNATIONAL_3)
&kp LC(PERIOD)  &kp LS(LA(LEFT))  &kp LC(B)       &kp LA(LS(RIGHT))  &kp LC(SLASH)   &kp LS(LC(H))      &kp SLASH   &kp LS(SQT)       &kp LS(SEMICOLON)  &kp RIGHT_BRACKET              &kp NUHS                       &mt RIGHT_SHIFT LS(SLASH)
&kp LC(LS(C))   &kp LC(LA(N0))    &kp LS(LC(V))   &trans             &trans          &kp LS(LC(M))      &kp DELETE  &trans                                                                                             &kp LS(INT1)
            >;

            sensor-bindings = <&inc_dec_kp LC(LS(PERIOD)) LC(LS(COMMA))>;
        };

        TEN_KEYS {
            bindings = <
&trans  &kp N7  &kp N8   &kp N9  &trans                               &kp LS(EQUAL)      &kp N7  &kp N8  &kp N9  &kp EQUAL
&trans  &kp N4  &kp N5   &kp N6  &kp UP    &trans      &kp MINUS      &kp LS(SEMICOLON)  &kp N4  &kp N5  &kp N7  &trans
&trans  &kp N1  &kp N2   &kp N3  &kp DOWN  &trans      &kp SLASH      &kp LS(SQT)        &kp N1  &kp N2  &kp N3  &kp DOT
&trans  &kp N0  &kp DOT  &trans  &trans    &trans      &kp BACKSPACE  &kp N0                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        Game {
            bindings = <
&kp CAPS   &kp Q    &kp W         &kp E  &kp R                                 &trans                &trans  &trans  &trans  &trans
&kp TAB    &kp A    &kp S         &kp D  &kp F      &trans      &trans         &trans                &trans  &kp K   &trans  &trans
&kp LSHFT  &kp Z    &kp X         &kp C  &kp V      &kp B       &kp DELETE     &trans                &trans  &trans  &trans  &trans
&kp LCTRL  &kp ESC  &kp LEFT_ALT  &kp G  &kp SPACE  &kp T       &kp BACKSPACE  &lt_to_layer_0 3 RET                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        GameShift {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        Apps {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        CONFIG {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans      &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans                          &bt BT_CLR_ALL
            >;
        };
    };
};
