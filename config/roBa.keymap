#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    quick-tap-ms = <220>;
    tapping-term-ms = <220>;
    require-prior-idle-ms = <50>;
};

&lt { require-prior-idle-ms = <100>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_mb3 {
            bindings = <&mkp MB3>;
            key-positions = <32 31>;
            layers = <4 0 1>;
            require-prior-idle-ms = <80>;
        };

        combo_tog_tenkeys {
            bindings = <&tog 9>;
            key-positions = <6 7 8>;
            layers = <0 9 1 2 4>;
        };

        combo_tog_game_mode {
            bindings = <&tog 2>;
            key-positions = <1 2 3>;
            layers = <0 3 4 2>;
        };

        combo_search_in_browser {
            bindings = <&ap_search 0 0>;
            key-positions = <28 16>;
            require-prior-idle-ms = <150>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_ctrl_left {
            bindings = <&kp LC(LEFT)>;
            key-positions = <18 19>;
            layers = <6>;
        };

        combo_ctrl_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <19 20>;
            layers = <6>;
        };

        combo_f2 {
            bindings = <&kp F2>;
            key-positions = <1 0>;
            layers = <0 1 4>;
            timeout-ms = <120>;
        };

        combo_f3 {
            bindings = <&kp F3>;
            key-positions = <3 4>;
            layers = <0 1 4>;
        };

        combo_f5 {
            bindings = <&kp F5>;
            key-positions = <5 6>;
            layers = <0 1 4>;
            require-prior-idle-ms = <150>;
        };

        combo_doublequate {
            bindings = <&kp LS(N2)>;
            key-positions = <30 31>;
            layers = <0 1 4>;
        };

        combo_underscore {
            bindings = <&kp LS(INTERNATIONAL_1)>;
            key-positions = <32 33>;
            layers = <0 1 4>;
        };

        combo_ctrl_z {
            bindings = <&kp LC(Z)>;
            key-positions = <22 23>;
            layers = <0 4>;
            timeout-ms = <300>;
        };

        combo_ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <23 24>;
            layers = <0 4>;
            timeout-ms = <200>;
        };

        combo_ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <11 12>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <12 13>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_ctrl_a {
            bindings = <&kp LC(A)>;
            key-positions = <0 10>;
            require-prior-idle-ms = <200>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_win_v {
            bindings = <&kp LG(V)>;
            key-positions = <13 14>;
            require-prior-idle-ms = <100>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_paste_plain_text {
            bindings = <&macro_plain_text>;
            key-positions = <24 25>;
            require-prior-idle-ms = <200>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_capslock {
            bindings = <&kp LS(CAPS)>;
            key-positions = <0 34>;
            layers = <0 1 4>;
            timeout-ms = <150>;
        };

        combo_teams_rich_textbox {
            bindings = <&kp LC(LS(X))>;
            key-positions = <0 9>;
            require-prior-idle-ms = <120>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_alt_f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <9 42>;
            layers = <0 4>;
            require-prior-idle-ms = <400>;
        };

        combo_mouse_move_window {
            bindings = <&macro_mouse_move_window>;
            key-positions = <6 8>;
            require-prior-idle-ms = <200>;
            layers = <6 4>;
        };

        combo_mouse_window_rd {
            bindings = <&macro_mouse_window_rd>;
            key-positions = <8 7>;
            require-prior-idle-ms = <200>;
            layers = <6 4>;
        };

        combo_mouse_window_ul {
            bindings = <&macro_mouse_window_ul>;
            key-positions = <6 7>;
            require-prior-idle-ms = <200>;
            layers = <6 4>;
        };

        combo_max_windows {
            bindings = <&kp LG(UP_ARROW)>;
            key-positions = <8 9>;
            require-prior-idle-ms = <200>;
            layers = <0 4>;
            timeout-ms = <120>;
        };

        combo_min_window {
            bindings = <&kp LG(DOWN)>;
            key-positions = <21 20>;
            require-prior-idle-ms = <200>;
            layers = <0 4>;
            timeout-ms = <120>;
        };

        combo_repop_window {
            bindings = <&kp LA(TAB)>;
            key-positions = <21 9>;
            layers = <0 4>;
            timeout-ms = <150>;
        };

        combo_snap_right_window {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <9 8>;
            layers = <6>;
        };

        combo_snap_left_window {
            bindings = <&kp LG(LEFT)>;
            key-positions = <5 6>;
            layers = <6>;
        };

        combo_window_spin_move {
            bindings = <&kp LS(LG(LEFT))>;
            key-positions = <20 18>;
            layers = <6>;
        };

        combo_select_window_right {
            bindings = <&kp LC(LA(TAB))>;
            key-positions = <32 31>;
            layers = <6>;
        };

        combo_select_window_left {
            bindings = <&kp LC(LS(LA(TAB)))>;
            key-positions = <31 30>;
            layers = <6>;
        };

        combo_savein_million {
            bindings = <&macro_savein_million>;
            key-positions = <17 18>;
            timeout-ms = <300>;
            layers = <6>;
        };

        combo_savein_takane {
            bindings = <&macro_savein_takane>;
            key-positions = <29 30>;
            timeout-ms = <150>;
            layers = <6>;
        };

        combo_savein_miki {
            bindings = <&macro_savein_miki>;
            key-positions = <17 16>;
            timeout-ms = <150>;
            layers = <6>;
        };

        combo_multi {
            bindings = <&macro_savein_multi>;
            key-positions = <29 28>;
            timeout-ms = <150>;
            layers = <6>;
        };

        combo_search {
            bindings = <&macro_copy_search_internet>;
            key-positions = <16 28>;
            layers = <6>;
            timeout-ms = <120>;
        };

        combo_clear_all_profiles {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <34 36>;
            layers = <9>;
            require-prior-idle-ms = <200>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer_1: to_layer_1 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_1";
        };

        macro_mkp_tap: macro_mkp_tap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>;
            label = "MACRO_MKP_TAP";
        };

        macro_kp_tap: macro_kp_tap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MACRO_KP_TAP";
        };

        macro_bt: macro_bt {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &macro_param_2to1 &to MACRO_PLACEHOLDER>;
            label = "MACRO_BT";
        };

        macro_mouse_move_window: macro_mouse_move_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LA(SPACE)>,
                <&macro_wait_time 150>,
                <&kp M &kp UP_ARROW &kp DOWN_ARROW>;

            label = "MACRO_MOUSE_MOVE_WINDOW";
        };

        macro_mouse_window_ul: macro_mouse_window_ul {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LA(SPACE)>,
                <&macro_wait_time 150>,
                <&kp S &kp LEFT_ARROW &kp UP_ARROW>;

            label = "MACRO_MOUSE_WINDOW_UL";
        };

        macro_mouse_window_rd: macro_mouse_window_rd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LA(SPACE)>,
                <&macro_wait_time 150>,
                <&kp S &kp RIGHT &kp DOWN_ARROW>;

            label = "MACRO_MOUSE_WINDOW_RD";
        };

        macro_plain_text: macro_plain_text {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(V)>,
                <&macro_wait_time 450>,
                <&kp LCTRL &kp TAB>,
                <&macro_wait_time 150>,
                <&kp LCTRL &kp ENTER>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp ENTER>;

            label = "MACRO_PLAIN_TEXT";
        };

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET &kp NUHS &kp LEFT>;
            label = "MACRO_BRACKETS";
        };

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACE &kp PIPE &kp LEFT>;
            label = "MACRO_BRACES";
        };

        macro_parenthesis: macro_parenthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MACRO_PARENTHESIS";
        };

        macro_gt_lt: macro_gt_lt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(COMMA) &kp LS(PERIOD) &kp LEFT>;
            label = "MACRO_GT_LT";
        };

        macro_home_end_select: macro_home_end_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kt LEFT_SHIFT &macro_param_1to1 &kp MACRO_PLACEHOLDER &kt LEFT_SHIFT &kp LC(C)>;
            label = "MACRO_HOME_END_SELECT";
        };

        macro_select_line: macro_select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kt LEFT_SHIFT &kp END &kt LEFT_SHIFT &kp LC(C)>;
            label = "MACRO_SELECT_LINE";
        };

        macro_emacs_k_cut: macro_emacs_k_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT &kp END &kt LEFT_SHIFT &kp LC(X)>;
            label = "MACRO_EMACS_K_CUT";
        };

        macro_cut_line: macro_cut_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kt LEFT_SHIFT &kp END &kp RIGHT &kt LEFT_SHIFT &kp LC(X)>;
            label = "MACRO_CUT_LINE";
        };

        macro_insert_at_head: macro_insert_at_head {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp INTERNATIONAL_5 &kt LEFT_SHIFT &kp HOME &kt LEFT_SHIFT &kp LC(X) &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp SPACE &kp LC(V)>;
            label = "MACRO_INSERT_AT_HEAD";
        };

        macro_delete_at_head: macro_delete_at_head {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_5 &kt LEFT_SHIFT &kp HOME &kp RIGHT &kp RIGHT &kt LSHFT &kp LC(X) &kp BACKSPACE &kp BACKSPACE &kp LC(V)>;
            label = "MACRO_DELETE_AT_HEAD";
        };

        macro_ascii_type: macro_ascii_type {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp INT_MUHENKAN &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MACRO_ASCII_TYPE";
        };

        macro_kp_togoff: macro_kp_togoff {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&togoff 4 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MACRO_KP_TOGOFF";
        };

        macro_mkp_togoff: macro_mkp_togoff {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&togoff 4 &macro_param_1to1 &mkp MACRO_PLACEHOLDER>;
            label = "MACRO_MKP_TOGOFF";
        };

        macro_copy_url: macro_copy_url {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(L) &kp LC(C) &kp ESCAPE>;
            label = "MACRO_COPY_URL";
        };

        macro_text_color: macro_text_color {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(H)>,
                <&macro_wait_time 50>,
                <&kp F &kp C &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN &kp DOWN_ARROW &kp DOWN>;

            label = "MACRO_TEXT_COLOR";
        };

        macro_text_align: macro_text_align {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kp LA(H)>,
                <&macro_wait_time 50>,
                <&kp A &macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "MACRO_TEXT_ALIGN";
        };

        macro_text_deco: macro_text_deco {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kp LA(H)>,
                <&macro_wait_time 50>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "MACRO_TEXT_DECO";
        };

        macro_ctrl_k_kp: macro_ctrl_k_ctrl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LC(K) &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MACRO_CTRL_K_CTRL";
        };

        macro_mo_togoff: macro_mo_togoff {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&togoff 4>;

            label = "MACRO_MO_TOGOFF";
        };

        macro_togoff_tog: macro_togoff_tog {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&togoff 4 &macro_param_1to1 &tog MACRO_PLACEHOLDER>;
            label = "MACRO_TOGOFF_TOG";
        };

        macro_mkp_togoff_sl: macro_mkp_togoff_sl {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl_short 4>;

            label = "MACRO_MKP_TOGOFF_SL";
        };

        macro_browser: macro_browser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp H &kp T &kp T &kp P &kp SQT &kp FSLH &kp FSLH &kp ENTER>;

            label = "MACRO_BROWSER";
        };

        macro_calculator: macro_calculator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp C &kp A &kp L &kp C &kp ENTER>;

            label = "MACRO_CALCULATOR";
        };

        macro_onenote: macro_onenote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp O &kp N &kp E &kp N &kp O &kp T &kp E &kp ENTER>;

            label = "MACRO_ONENOTE";
        };

        macro_teams: macro_teams {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp M &kp S &kp MINUS &kp T &kp E &kp A &kp M &kp S &kp ENTER>;

            label = "MACRO_TEAMS";
        };

        macro_outlook: macro_outlook {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp RCTRL &kp O &kp U &kp T &kp L &kp O &kp O &kp K &kp ENTER>;

            label = "MACRO_OUTLOOK";
        };

        macro_word: macro_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp W &kp I &kp N &kp W &kp O &kp R &kp D &kp ENTER>;

            label = "MACRO_WORD";
        };

        macro_excel: macro_app_excel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp E &kp X &kp C &kp E &kp L &kp ENTER>;

            label = "MACRO_APP_EXCEL";
        };

        macro_powerpoint: macro_powerpoint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp P &kp O &kp W &kp E &kp R &kp P &kp N &kp T &kp ENTER>;

            label = "MACRO_POWERPOINT";
        };

        macro_capture: macro_capture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp S &kp N &kp I &kp P &kp P &kp I &kp N &kp G &kp T &kp O &kp O &kp L &kp ENTER>;

            label = "MACRO_CAPTURE";
        };

        macro_itunes: macro_itunes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp I &kp T &kp U &kp N &kp E &kp S &kp ENTER>;

            label = "MACRO_ITUNES";
        };

        macro_vscode: macro_vscode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp C &kp O &kp D &kp E &kp ENTER>;

            label = "MACRO_VSCODE";
        };

        macro_notepad: macro_notepad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp N &kp O &kp T &kp E &kp P &kp A &kp D &kp ENTER>;

            label = "MACRO_NOTEPAD";
        };

        macro_hidemaru: macro_hidemaru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(C) &kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp H &kp I &kp D &kp E &kp M &kp A &kp R &kp U &kp ENTER>,
                <&macro_wait_time 200>,
                <&kp LC(V)>;

            label = "MACRO_HIDEMARU";
        };

        macro_audirvana: macro_audirvana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp A &kp U &kp D &kp I &kp R &kp V &kp A &kp N &kp A &kp ENTER>;

            label = "MACRO_AUDIRVANA";
        };

        macro_todo: macro_todo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp INTERNATIONAL_5 &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp T &kp O &kp D &kp O &kp ENTER>;

            label = "MACRO_TODO";
        };

        macro_copy_search_internet: macro_copy_search_internet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(C) &kp LG(R)>,
                <&macro_wait_time 200>,
                <&kp LCTRL &kp H &kp T &kp T &kp P &kp SQT &kp FSLH &kp FSLH &kp G &kp O &kp O &kp G &kp L &kp E &kp DOT &kp C &kp O &kp M &kp FSLH &kp S &kp E &kp A &kp R &kp C &kp H &kp LS(SLASH) &kp Q &kp LS(MINUS) &kp LC(V) &kp ENTER>;

            label = "MACRO_COPY_SEARCH_INTERNET";
        };

        macro_copy_search_in_app: macro_copy_search_in_app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C) &kp LC(E) &kp LC(V) &kp ENTER>;
            label = "MACRO_COPY_SEARCH_IN_APP";
        };

        macro_onenote_quicknote: macro_onenote_quicknote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(N))>;
            label = "MACRO_ONENOTE_QUICKNOTE";
        };

        macro_open_in_vscode: macro_open_in_vscode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp K_CMENU &kp RCTRL>,
                <&macro_wait_time 400>,
                <&kp RCTRL &kp UP_ARROW &kp ENTER>,
                <&macro_wait_time 250>,
                <&kp RCTRL &kp C>;

            label = "MACRO_OPEN_IN_VSCODE";
        };

        macro_open_in_sharepoint: macro_open_in_sharepoint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp K_CMENU &kp RCTRL>,
                <&macro_wait_time 400>,
                <&kp RCTRL &kp UP_ARROW &kp ENTER>,
                <&macro_wait_time 250>,
                <&kp RCTRL &kp V &kp V &kp ENTER>;

            label = "MACRO_OPEN_IN_SHAREPOINT";
        };

        macro_explorer: macro_explorer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(E)>;
            label = "MACRO_EXPLORER";
        };

        macro_savein_million: macro_savein_million {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mkp MB2>,
                <&macro_wait_time 50>,
                <&kp E &kp DOWN_ARROW>;

            label = "MACRO_SAVEIN_MILLION";
        };

        macro_savein_takane: macro_savein_takane {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mkp MB2>,
                <&macro_wait_time 50>,
                <&kp E &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW>;

            label = "MACRO_SAVEIN_TAKANE";
        };

        macro_savein_miki: macro_savein_miki {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mkp MB2>,
                <&macro_wait_time 50>,
                <&kp E &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW>;

            label = "MACRO_SAVEIN_MIKI";
        };

        macro_savein_multi: macro_savein_multi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mkp MB2>,
                <&macro_wait_time 50>,
                <&kp E &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW &kp DOWN_ARROW>;

            label = "MACRO_SAVEIN_MULTI";
        };
    };

    behaviors {
        mmb: mmb {
            compatible = "zmk,behavior-hold-tap";
            label = "MMB";
            bindings = <&macro_mkp_tap>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
        };

        lt_hold_qt: lt_hold_qt {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD_QT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            require-prior-idle-ms = <50>;
            quick-tap-ms = <200>;
        };

        lt_tap_qt: lt_tap_qt {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TAP_QT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        mt_norepeat: mt_norepeat {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_NOREPEAT";
            bindings = <&macro_kp_tap>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <60>;
        };

        mt_long: mt_long {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_LONG";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            retro-tap;
            require-prior-idle-ms = <120>;
        };

        togoff: togoff {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOGOFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        sl_short: sl_short {
            compatible = "zmk,behavior-sticky-key";
            label = "SL_SHORT";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <300>;
            quick-release;
        };

        lt_layer: lt_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_LAYER";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_togoff: lt_togoff {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TOGOFF";
            bindings = <&macro_mo_togoff>, <&macro_kp_togoff>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_togoff: mt_togoff {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TOGOFF";
            bindings = <&macro_kp_togoff>, <&macro_kp_togoff>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <60>;
        };

        lt_mkp_togoff: lt_mkp_togoff {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_MKP_TOGOFF";
            bindings = <&macro_mo_togoff>, <&macro_mkp_togoff_sl>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
        };

        lt_layer_togoff: lt_layer_togoff {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_LAYER_TOGOFF";
            bindings = <&macro_mo_togoff>, <&macro_togoff_tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <140>;
        };

        lt_to_layer_1: lt_to_layer_1 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO_LAYER_1";
            bindings = <&mo>, <&to_layer_1>;

            #binding-cells = <2>;
            tapping-term-ms = <140>;
        };

        sc_sel_line: sc_sel_line {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_SEL_LINE";
            bindings = <&macro_select_line>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <60>;
        };

        sc_sel_line_none: sc_sel_line_none {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_SEL_LINE_NONE";
            bindings = <&macro_select_line>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "tap-preferred";
        };

        sc_emacs: sc_emacs {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_EMACS";
            bindings = <&macro_emacs_k_cut>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <60>;
        };

        sc_sel_cut_line: sc_sel_cut_line {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_SEL_CUT_LINE";
            bindings = <&macro_cut_line>, <&macro_select_line>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <60>;
        };

        mat_inset_at_head: mat_inset_at_head {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_INSET_AT_HEAD";
            bindings = <&macro_insert_at_head>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mat_home_end_select: mat_home_end_select {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_HOME_END_SELECT";
            bindings = <&macro_home_end_select>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        sc_brace: sc_brace {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_BRACE";
            bindings = <&macro_braces>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        sc_bracket: sc_bracket {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_BRACKET";
            bindings = <&macro_brackets>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        sc_parenthesis: sc_parenthesis {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_PARENTHESIS";
            bindings = <&macro_parenthesis>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        sc_gt_lt: sc_gt_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "SC_GT_LT";
            bindings = <&macro_gt_lt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        ap_music: ap_music {
            compatible = "zmk,behavior-hold-tap";
            label = "AP_MUSIC";
            bindings = <&macro_audirvana>, <&macro_itunes>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "tap-preferred";
        };

        ap_onenote: ap_onenote {
            compatible = "zmk,behavior-hold-tap";
            label = "AP_ONENOTE";
            bindings = <&macro_onenote>, <&macro_onenote_quicknote>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        ap_editor: ap_editor {
            compatible = "zmk,behavior-hold-tap";
            label = "AP_EDITOR";
            bindings = <&macro_hidemaru>, <&macro_notepad>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        ap_vscode: ap_vscode {
            compatible = "zmk,behavior-hold-tap";
            label = "AP_VSCODE";
            bindings = <&macro_open_in_vscode>, <&macro_vscode>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        ap_explorer: ap_explorer {
            compatible = "zmk,behavior-hold-tap";
            label = "AP_EXPLORER";
            bindings = <&macro_open_in_sharepoint>, <&macro_explorer>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
        };

        ap_search: ap_search {
            compatible = "zmk,behavior-hold-tap";
            label = "AP_SEARCH";
            bindings =
                <&macro_copy_search_internet>,
                <&macro_copy_search_in_app>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <200>;
        };

        mt_z: mt_z {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_Z";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            require-prior-idle-ms = <80>;
            flavor = "balanced";
        };

        mmb_short_hold: mmb_short_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "MMB_SHORT_HOLD";
            bindings = <&macro_mkp_tap>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <50>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <1000>;
        };

        lt_scroll: lt_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SCROLL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <50>;
            require-prior-idle-ms = <750>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q        &mat_home_end_select HOME W  &sc_sel_line 0 E     &mat_home_end_select END R        &sc_emacs 0 T                                                                     &mt_norepeat LS(COMMA) Y    &mt_norepeat LS(DOT) U       &mt_norepeat LS(N8) I         &mt_norepeat LS(N9) O  &kp MINUS
&mt_long LCTRL A    &mt_long LEFT_SHIFT S        &mt_long LEFT_ALT D  &mt_long LEFT_CONTROL F           &mt_long LEFT_GUI G  &none                                 &mmb MB5 LEFT_BRACKET  &mt_norepeat RIGHT_BRACE H  &mt_norepeat PIPE J          &mt_norepeat RIGHT_BRACKET K  &mt_norepeat NUHS L    &mt_long RCTRL P
&mt_z LEFT_SHIFT Z  &kp X                        &kp C                &kp V                             &kp B                &lt 9 INT1                            &mmb MB4 LS(N3)        &mt_norepeat SEMI N         &mt_norepeat SINGLE_QUOTE M  &mmb_short_hold MB1 COMMA     &lt_scroll 5 DOT       &mt RIGHT_SHIFT SLASH
&kp LCTRL           &kp LEFT_WIN                 &kp LEFT_ALT         &lt_to_layer_0 8 INTERNATIONAL_5  &lt_hold_qt 5 SPACE  &lt_to_layer_0 7 INTERNATIONAL_4      &kp BACKSPACE          &lt_to_layer_0 6 RET                                                                                          &mo 5
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        APPLE {
            bindings = <
&trans               &trans     &trans  &trans               &trans                                           &trans                  &trans  &trans  &trans  &trans
&mt_long LEFT_GUI A  &trans     &trans  &mt_long LEFT_GUI F  &trans  &trans                           &trans  &trans                  &trans  &trans  &trans  &mt_long RIGHT_GUI P
&trans               &trans     &trans  &trans               &trans  &trans                           &trans  &trans                  &trans  &trans  &trans  &trans
&kp LEFT_GUI         &kp LCTRL  &trans  &kp LANGUAGE_2       &trans  &lt_to_layer_1 7 LANGUAGE_1      &trans  &lt_to_layer_1 6 ENTER                          &trans
            >;
        };

        GAME {
            bindings = <
&kp CAPS   &kp Q    &kp W         &kp E  &kp R                                 &trans                &trans  &trans  &trans  &trans
&kp TAB    &kp A    &kp S         &kp D  &kp F      &trans      &trans         &trans                &trans  &kp K   &trans  &trans
&kp LSHFT  &kp Z    &kp X         &kp C  &kp V      &kp G       &kp DELETE     &trans                &trans  &trans  &trans  &trans
&kp LCTRL  &kp ESC  &kp LEFT_ALT  &mo 7  &kp SPACE  &kp B       &kp BACKSPACE  &lt_to_layer_0 6 RET                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        GAME_SHIFT {
            bindings = <
&trans  &trans  &trans  &trans  &kp T                       &trans  &trans  &trans  &trans  &trans
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&mt_togoff ESCAPE Q  &macro_kp_togoff W  &macro_kp_togoff E  &macro_kp_togoff R            &macro_kp_togoff T                                                                &mt_togoff LS(COMMA) Y    &mt_togoff LS(PERIOD) U  &mt_togoff LS(N8) I         &mt_togoff LS(N9) O       &macro_kp_togoff MINUS
&trans               &macro_kp_togoff S  &macro_kp_togoff D  &macro_kp_togoff F            &macro_kp_togoff G  &trans                            &trans                      &mt_togoff RIGHT_BRACE H  &mt_togoff PIPE J        &mt_togoff RIGHT_BRACKET K  &mt_togoff NON_US_HASH L  &trans
&trans               &macro_kp_togoff X  &macro_kp_togoff C  &macro_kp_togoff V            &macro_kp_togoff B  &macro_mo_togoff 9                &trans                      &mt_togoff SEMI N         &mt_togoff SQT M         &mkp MB1                    &lt_mkp_togoff 5 MB2      &trans
&trans               &trans              &trans              &lt_togoff 8 INTERNATIONAL_5  &lt_togoff 5 SPACE  &lt_togoff 7 INTERNATIONAL_4      &macro_kp_togoff BACKSPACE  &lt_togoff 6 RET                                                                                         &macro_kp_togoff ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        NUM_BAR_SYMBOLS_SCROLL {
            bindings = <
&kp EXCLAMATION         &kp LS(N2)  &mat_inset_at_head HASH HASH  &kp DOLLAR    &kp PERCENT                                          &sc_gt_lt 0 LS(N6)  &kp LS(N7)  &sc_parenthesis 0 LS(N8)  &kp LS(N9)  &kp LS(EQUAL)
&kp N1                  &kp N2      &kp N3                        &kp N4        &kp N5       &trans         &kp DOT                  &sc_brace 0 N6      &kp N7      &sc_bracket 0 N8          &kp N9      &mt_long RCTRL N0
&mt_z LEFT_SHIFT SLASH  &kp MINUS   &kp LS(SQT)                   &kp LS(SEMI)  &kp EQUAL    &kp MINUS      &kp LS(INTERNATIONAL_3)  &kp SEMI            &kp SQT     &mkp MB1                  &trans      &trans
&trans                  &trans      &trans                        &trans        &trans       &trans         &kp DELETE               &kp DEL                                                               &kp INT1
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        FOLD_ARROW {
            bindings = <
&macro_ctrl_k_kp LC(N1)  &macro_ctrl_k_kp LC(N2)  &macro_ctrl_k_kp LC(N3)  &macro_ctrl_k_kp LC(N4)  &macro_ctrl_k_kp LC(J)                                        &mt_norepeat LC(LS(T)) LC(T)  &mt_norepeat LC(PAGE_UP) LC(LS(TAB))  &kp UP_ARROW           &mt_norepeat LC(PAGE_DOWN) LC(TAB)  &mt_norepeat LC(W) ESCAPE
&kp LA(LS(N1))           &kp LA(LS(N2))           &kp LA(LS(N3))           &kp LA(LS(N4))           &kp LA(LS(N0))          &trans                    &kp PG_UP   &kp TAB                       &kp LEFT                              &kp DOWN               &kp RIGHT                           &kp RCTRL
&kp LEFT_SHIFT           &trans                   &trans                   &trans                   &trans                  &sc_sel_cut_line 0 0      &kp PG_DN   &kp LA(UP_ARROW)              &mat_home_end_select HOME HOME        &sc_sel_line_none 0 0  &mat_home_end_select END END        &kp RIGHT_SHIFT
&trans                   &trans                   &trans                   &kp LS(TAB)              &kp TAB                 &kp LEFT_WIN              &kp DELETE  &trans                                                                                                                         &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        FUNCTION_APP_MEDIA {
            bindings = <
&macro_capture   &macro_teams  &macro_outlook    &macro_browser  &macro_copy_url                                                  &macro_word      &macro_excel  &macro_powerpoint  &ap_vscode 0 0  &ap_editor 0 0
&kp F1           &kp F2        &kp F3            &kp F4          &kp F5           &trans                       &macro_calculator  &kp F6           &kp F7        &kp F8             &kp F9          &kp F10
&kp C_STOP       &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT      &kp C_MUTE       &mt LG(LA(T)) LC(LS(M))      &ap_music 0 0      &kp F11          &kp F12       &trans             &trans          &trans
&kp PRINTSCREEN  &trans        &trans            &trans          &trans           &trans                       &ap_explorer 0 0   &ap_onenote 0 0                                                   &macro_todo
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        TEXT_EDIT {
            bindings = <
&kp LC(N1)           &kp LC(N2)           &kp LC(N3)           &kp LC(N4)      &kp LC(N0)                                 &trans  &macro_text_deco U  &kp LS(LA(UP))      &macro_text_deco N  &trans
&kp LC(LA(N1))       &kp LC(LA(N2))       &kp LC(LA(N3))       &kp LC(LA(N4))  &kp LC(LA(N0))  &trans             &trans  &trans  &kp LS(LA(LEFT))    &kp LS(LA(DOWN))    &kp LS(LA(RIGHT))   &trans
&trans               &trans               &kp LS(LC(C))        &kp LS(LC(V))   &kp LC(B)       &kp LS(LC(H))      &trans  &trans  &macro_text_color   &macro_text_deco H  &kp LC(DOT)         &kp LC(FSLH)
&macro_text_align L  &macro_text_align C  &macro_text_align R  &trans          &trans          &trans             &trans  &trans                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LS(PERIOD)) LC(LS(COMMA))>;
        };

        BT_TEN_KEYS {
            bindings = <
&macro_bt 0 0  &macro_bt 1 0  &macro_bt 2 1  &macro_bt 3 0  &macro_bt 4 0                             &kp LS(SQT)   &kp N7  &kp N8  &kp N9  &kp TAB
&to 0          &to 1          &trans         &trans         &trans         &trans      &kp LS(SLASH)  &kp MINUS     &kp N4  &kp N5  &kp N6  &kp ENTER
&trans         &trans         &trans         &trans         &trans         &trans      &kp SQT        &kp LS(SEMI)  &kp N1  &kp N2  &kp N3  &kp DOT
&bt BT_CLR     &trans         &trans         &trans         &trans         &trans      &trans         &kp N0                                &trans
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        APPLICATION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
