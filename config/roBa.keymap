#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    quick-tap-ms = <220>;
    tapping-term-ms = <250>;
    require-prior-idle-ms = <50>;
};

&lt { require-prior-idle-ms = <100>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_mb1 {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
            timeout-ms = <450>;
            layers = <0 4 5 1>;
            require-prior-idle-ms = <20>;
        };

        combo_mb2 {
            bindings = <&mkp MB2>;
            key-positions = <20 19>;
            timeout-ms = <250>;
            layers = <0 5 4 1>;
            require-prior-idle-ms = <100>;
        };

        combo_mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 20>;
            timeout-ms = <250>;
            layers = <0 4 5>;
            require-prior-idle-ms = <200>;
        };

        combo_tog_tenkeys {
            bindings = <&tog 8>;
            key-positions = <6 7 8>;
            layers = <0 8>;
        };

        combo_tog_game_mode {
            bindings = <&tog 9>;
            key-positions = <1 2 3>;
            layers = <0 9>;
        };

        combo_mouse_move_window {
            bindings = <&macro_mouse_move_window>;
            key-positions = <5 9>;
            require-prior-idle-ms = <300>;
            layers = <3>;
        };

        combo_mouse_window_rd {
            bindings = <&macro_mouse_window_rd>;
            key-positions = <6 9>;
            require-prior-idle-ms = <300>;
            layers = <3>;
        };

        combo_mouse_window_ul {
            bindings = <&macro_mouse_window_ul>;
            key-positions = <8 5>;
            require-prior-idle-ms = <300>;
            layers = <3>;
        };

        combo_max_windows {
            bindings = <&kp LG(UP_ARROW)>;
            key-positions = <20 21>;
            require-prior-idle-ms = <300>;
            layers = <3>;
            timeout-ms = <150>;
        };

        combo_min_window {
            bindings = <&kp LG(DOWN)>;
            key-positions = <33 32>;
            require-prior-idle-ms = <300>;
            layers = <3>;
            timeout-ms = <150>;
        };

        combo_repop_window {
            bindings = <&kp LA(TAB)>;
            key-positions = <32 42>;
            require-prior-idle-ms = <300>;
            layers = <3>;
        };

        combo_snap_right_window {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <30 33>;
            require-prior-idle-ms = <300>;
            layers = <3>;
        };

        combo_snap_left_window {
            bindings = <&kp LG(LEFT)>;
