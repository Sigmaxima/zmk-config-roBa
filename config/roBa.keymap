#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt { quick-tap-ms = <300>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_mkp_mb1 {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
            timeout-ms = <150>;
            layers = <0 4 5>;
        };

        combo_mkb_mb2 {
            bindings = <&mkp MB2>;
            key-positions = <20 19>;
            timeout-ms = <80>;
            layers = <4 5 0>;
            require-prior-idle-ms = <200>;
        };

        combo_mkp_mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 20>;
            timeout-ms = <150>;
            layers = <0 4 5>;
            require-prior-idle-ms = <200>;
        };

        combo_mkb_mb2_e {
            bindings = <&macro_mkp_mb2_e>;
            key-positions = <20 21>;
            timeout-ms = <150>;
            layers = <4 5>;
        };

        combo_tog_tenkeys {
            bindings = <&tog 6>;
            key-positions = <6 7 8>;
        };

        combo_tog_game_mode {
            bindings = <&tog 7>;
            key-positions = <1 2 3>;
        };

        kp_f2 {
            bindings = <&kp F2>;
            key-positions = <1 0>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_kp_f5 {
            bindings = <&kp F5>;
            key-positions = <5 6>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_kp_f11 {
            bindings = <&kp F11>;
            key-positions = <8 9>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_kp_doublequate {
            bindings = <&kp LS(N2)>;
            key-positions = <14 13>;
            layers = <0>;
        };

        combo_kp_singlequate {
            bindings = <&kp LS(N7)>;
            key-positions = <17 18>;
            layers = <0>;
        };

        macro_f3 {
            bindings = <&kp F3>;
            key-positions = <3 4>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_max_windows {
            bindings = <&kp LG(UP_ARROW)>;
            key-positions = <21 20>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_min_window {
            bindings = <&kp LG(DOWN)>;
            key-positions = <33 32>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_search {
            bindings = <&macro_copy_search>;
            key-positions = <30 32>;
            layers = <0>;
        };

        combo_ctrl_z {
            bindings = <&kp LC(Z)>;
            key-positions = <22 23>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <23 24>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <11 12>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };

        combo_ctrl_v {
            bindings = <&kp LC(V)>;
            key-positions = <12 13>;
            require-prior-idle-ms = <300>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        macro_emacs_k_cut_to_end: emacs_k {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT &kp END &kt LEFT_SHIFT &kp LC(X)>;
            label = "EMACS_K";
        };

        macro_mb1withctrl: mb1withctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt RCTRL &mkp MB1 &kt RCTRL>;
            label = "MB1WITHCTRL";
        };

        macro_mkp_mb2_e: macro_mkp_mb2_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB2 &kp E &kp DOWN_ARROW>;
            label = "MACRO_MKP_MB2_E";
        };

        app_teams: app_teams {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp M &kp S &kp MINUS &kp T &kp E &kp A &kp M &kp S &kp ENTER>;

            label = "APP_TEAMS";
        };

        app_word: app_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp W &kp I &kp N &kp W &kp O &kp R &kp D &kp ENTER>;

            label = "APP_WORD";
        };

        app_excel: app_excel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp E &kp X &kp C &kp E &kp L &kp ENTER>;

            label = "APP_EXCEL";
        };

        app_calculator: app_onenote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp C &kp A &kp L &kp C &kp ENTER>;

            label = "APP_ONENOTE";
        };

        app_onenote: app_calculator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp O &kp N &kp E &kp N &kp O &kp T &kp E &kp ENTER>;

            label = "APP_CALCULATOR";
        };

        app_edge: app_edge {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp M &kp S &kp E &kp D &kp G &kp E &kp ENTER>;

            label = "APP_EDGE";
        };

        app_powerpoint: app_firefox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp P &kp O &kp W &kp E &kp R &kp P &kp N &kp T &kp ENTER>;

            label = "APP_FIREFOX";
        };

        app_firefox: app_powerpnt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp F &kp I &kp R &kp E &kp F &kp O &kp X &kp ENTER>;

            label = "APP_POWERPNT";
        };

        app_outlook: app_outlook {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp O &kp U &kp T &kp L &kp O &kp O &kp K &kp ENTER>;

            label = "APP_OUTLOOK";
        };

        macro_move_window: macro_move_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(SPACE)>,
                <&macro_wait_time 50>,
                <&kp M &kp UP_ARROW &kp DOWN_ARROW>;

            label = "MACRO_MOVE_WINDOW";
        };

        macro_resize_window_ul: macro_resize_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(SPACE)>,
                <&macro_wait_time 50>,
                <&kp S &kp LEFT_ARROW &kp UP_ARROW>;

            label = "MACRO_RESIZE_WINDOW";
        };

        macro_resize_windows_rd: macro_resize_windows_rd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(SPACE)>,
                <&macro_wait_time 50>,
                <&kp S &kp RIGHT &kp DOWN_ARROW>;

            label = "MACRO_RESIZE_WINDOWS_RD";
        };

        macro_copy_search: macro_copy_search {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(C) &kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp H &kp T &kp T &kp P &kp S &kp SQT &kp FSLH &kp FSLH &kp W &kp W &kp W &kp DOT &kp G &kp O &kp O &kp G &kp L &kp E &kp DOT &kp C &kp O &kp M &kp FSLH &kp S &kp E &kp A &kp R &kp C &kp H &kp QMARK &kp Q &kp LS(MINUS)>,
                <&macro_wait_time 20>,
                <&kp LC(V) &kp ENTER>;

            label = "MACRO_COPY_SEARCH";
        };

        macro_browser: macro_browser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp H &kp T &kp T &kp P &kp SQT &kp FSLH &kp FSLH &kp ENTER>;

            label = "MACRO_BROWSER";
        };

        macro_capture: macro_capture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 80>,
                <&kp S &kp N &kp I &kp P &kp P &kp I &kp N &kp G &kp T &kp O &kp O &kp L &kp ENTER>;

            label = "MACRO_CAPTURE";
        };

        macro_ascii_type: macro_modtype {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp INT_MUHENKAN &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MACRO_MODTYPE";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mat_emacs: mat_emacs {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_EMACS";
            bindings = <&macro_emacs_k_cut_to_end>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "SCROLL_UP_DOWN";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };

        mt_tap_preferred: mt_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        mt_long_press: mt_long_press {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_LONG_PRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
            retro-tap;
            require-prior-idle-ms = <80>;
        };

        lt_long_press: lt_long_press {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_LONG_PRESS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <80>;
        };

        mat_ascii_type: mat_ascii_type {
            compatible = "zmk,behavior-hold-tap";
            label = "MAT_ASCII_TYPE";
            bindings = <&macro_ascii_type>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q            &kp W                        &kp E                      &kp R                             &kp T                                                                           &kp Y                 &kp U                           &kp I               &kp O                         &kp MINUS
&mt_long_press LCTRL A  &mt_long_press LEFT_SHIFT S  &mt_long_press LEFT_ALT D  &mt_long_press LEFT_CONTROL F     &kp G                   &none                                 &kp LEFT_BRACKET  &kp H                 &mt_long_press RIGHT_CONTROL J  &lt_long_press 5 K  &mt_long_press RIGHT_SHIFT L  &mt RCTRL P
&mt LEFT_SHIFT Z        &kp X                        &kp C                      &kp V                             &kp B                   &kp LS(N3)                            &kp LS(MINUS)     &kp N                 &kp M                           &kp COMMA           &kp DOT                       &mt RIGHT_SHIFT SLASH
&kp LCTRL               &kp LEFT_WIN                 &kp LEFT_ALT               &lt_to_layer_0 2 INTERNATIONAL_5  &lt_to_layer_0 2 SPACE  &lt_to_layer_0 1 INTERNATIONAL_4      &kp BACKSPACE     &lt_to_layer_0 3 RET                                                                                    &mt_long_press RCTRL INT1
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        FUNCTION_APPLICATION {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4  &kp F5                                &app_outlook  &app_onenote    &app_word       &app_excel  &app_powerpoint
&kp F6   &kp F7   &kp F8   &kp F9  &kp F10  &trans      &macro_capture   &kp LG(E)     &kp C_PP        &kp C_PREVIOUS  &kp C_NEXT  &trans
&kp F11  &kp F12  &kp F13  &trans  &trans   &trans      &app_calculator  &app_teams    &macro_browser  &kt C_STOP      &kp C_MUTE  &trans
&trans   &trans   &trans   &trans  &trans   &trans      &trans           &trans                                                    &trans
            >;
        };

        SYMBOLS {
            bindings = <
&kp EXCLAMATION       &kp LS(N2)  &mt_tap_preferred LC(E) HASH  &kp DOLLAR      &kp PERCENT                                   &kp LS(NUMBER_6)  &kp LS(N7)         &mat_ascii_type LS(N8) LS(N8)  &mat_ascii_type LS(N9) LS(N9)  &mt PRINTSCREEN EQUAL
&kp LC(A)             &kp LC(S)   &kp LS(LEFT_BRACKET)          &kp LC(F)       &kp LS(EQUAL)  &trans             &kp MINUS   &kp RIGHT_BRACE   &kp PIPE           &mat_emacs 0 SEMI              &mat_ascii_type SQT SQT        &kp LS(INTERNATIONAL_3)
&mt LEFT_SHIFT LC(Z)  &kp LC(X)   &kp LC(C)                     &kp LC(V)       &kp LC(B)      &kp LG(V)          &kp SLASH   &kp LS(SQT)       &kp LS(SEMICOLON)  &kp RIGHT_BRACKET              &kp NUHS                       &mt RIGHT_SHIFT LS(SLASH)
&trans                &trans      &trans                        &kp LEFT_SHIFT  &trans         &kp LS(LC(M))      &kp DELETE  &kp LC(LS(X))                                                                                      &kp LS(INT1)
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        ARROW_NUM {
            bindings = <
&mt ESCAPE N1             &kp N2           &kp N3        &kp N4       &kp N5                                                  &macro_move_window        &kp LC(PAGE_UP)  &kp UP_ARROW     &kp LC(PAGE_DOWN)  &kp ESC
&kp N6                    &kp N7           &kp N8        &kp N9       &kp N0   &trans                &macro_resize_window_ul  &macro_resize_windows_rd  &kp LEFT         &kp DOWN         &kp RIGHT          &kp RCTRL
&mt LEFT_SHIFT KP_DIVIDE  &kp KP_ASTERISK  &kp KP_MINUS  &kp KP_PLUS  &kp DOT  &kp LS(MINUS)         &kp LG(LEFT)             &kp LG(RIGHT)             &kp HOME         &kp RIGHT_SHIFT  &kp END            &kp RIGHT_SHIFT
&trans                    &trans           &trans        &kp LS(TAB)  &kp TAB  &kp LS(CAPSLOCK)      &kp DELETE               &trans                                                                         &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &mkp MB3  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mo 5     &mkp MB2  &kp RCTRL
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &kp RIGHT_SHIFT
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        SCROLL {
            bindings = <
&kp LA(F4)  &kp LG(LS(LEFT))  &kp LG(UP_ARROW)    &kp LG(LS(RIGHT))        &kp LG(D)                                                                  &macro_move_window        &kp LC(PAGE_UP)  &none      &kp LC(PAGE_DOWN)  &kp LC(T)
&trans      &kp LG(LEFT)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT)            &trans              &trans                        &macro_resize_window_ul  &macro_resize_windows_rd  &mkp MB1         &trans     &mkp MB2           &kp RIGHT_CONTROL
&trans      &trans            &kp LG(TAB)         &trans                   &trans              &mo 10                        &kp LG(LEFT_ARROW)       &kp LG(RIGHT)             &mkp MB4         &kp LC(W)  &mkp MB5           &kp RIGHT_SHIFT
&trans      &trans            &trans              &macro_resize_window_ul  &macro_move_window  &macro_resize_windows_rd      &kp LS(LG(LEFT_ARROW))   &kp LC(LA(TAB))                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(MINUS) LS(LC(MINUS))>;
        };

        TEN_KEYS {
            bindings = <
&trans  &kp N7  &kp N8   &kp N9  &trans                               &kp LS(EQUAL)      &kp N7  &kp N8  &kp N9  &kp EQUAL
&trans  &kp N4  &kp N5   &kp N6  &kp UP    &trans      &kp MINUS      &kp LS(SEMICOLON)  &kp N4  &kp N5  &kp N7  &trans
&trans  &kp N1  &kp N2   &kp N3  &kp DOWN  &trans      &kp SLASH      &kp LS(SQT)        &kp N1  &kp N2  &kp N3  &kp DOT
&trans  &kp N0  &kp DOT  &trans  &trans    &trans      &kp BACKSPACE  &kp N0                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        Game {
            bindings = <
&kp CAPS   &kp Q    &kp W         &kp E  &kp R                                 &trans                &trans  &trans  &trans  &trans
&kp TAB    &kp A    &kp S         &kp D  &kp F      &trans      &trans         &trans                &trans  &kp K   &trans  &trans
&kp LSHFT  &kp Z    &kp X         &kp C  &kp V      &kp B       &kp DELETE     &trans                &trans  &trans  &trans  &trans
&kp LCTRL  &kp ESC  &kp LEFT_ALT  &kp G  &kp SPACE  &kp T       &kp BACKSPACE  &lt_to_layer_0 3 RET                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        GameShift {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        Apps {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        CONFIG {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans       &trans  &trans  &trans  &trans  &trans
&trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans      &bootloader  &trans  &trans  &trans  &trans  &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans      &trans       &trans                          &bt BT_CLR_ALL
            >;
        };
    };
};
