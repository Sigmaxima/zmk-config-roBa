        combo_savein_million {
            bindings = <&macro_savein_million>;
            key-positions = <20 21>;
            timeout-ms = <300>;
            layers = <5>;
        };

        combo_savein_takane {
            bindings = <&macro_savein_takane>;
            key-positions = <32 33>;
            timeout-ms = <500>;
            layers = <5>;
        };

        combo_savein_miki {
            bindings = <&macro_savein_miki>;
            key-positions = <42 41>;
            timeout-ms = <500>;
            layers = <5>;
        };

        combo_multi {
            bindings = <&macro_savein_multi>;
            key-positions = <42 40>;
            timeout-ms = <300>;
            layers = <5>;
        };

        combo_clear_bt {
            bindings = <&bt BT_CLR>;
            key-positions = <10 14>;
            layers = <5>;
        };

        combo_clear_all_bt {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <22 27>;
            layers = <5>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer_1: to_layer_1 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_1";
        };

        macro_tripleclick: macro_tripleclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB1 &mkp MB1 &mkp MB1>;
            label = "MACRO_TRIPLECLICK";
        };

        macro_bat_and_return: macro_bat_and_return {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MACRO_BAT_AND_RETURN";
        };

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET &kp NUHS &kp LEFT>;
            label = "MACRO_BRACKETS";
        };

        macro_brace: macro_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACE &kp PIPE &kp LEFT>;
            label = "MACRO_BRACE";
        };

        macro_parenthesis: macro_parenthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MACRO_PARENTHESIS";
        };

        macro_select_line: macro_select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kt LEFT_SHIFT &kp END &kt LEFT_SHIFT &kp LC(C)>;
            label = "MACRO_SELECT_LINE";
        };

        macro_emacs_k_cut_to_end: macro_emacs_k_cut_to_end {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT &kp END &kt LEFT_SHIFT &kp LC(X)>;
