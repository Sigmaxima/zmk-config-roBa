            key-positions = <8 9>;
            layers = <0>;
            require-prior-idle-ms = <300>;
        };

        combo_doublequate {
            bindings = <&kp LS(N2)>;
            key-positions = <30 31>;
            layers = <0>;
        };

        combo_underscore {
            bindings = <&kp LS(INTERNATIONAL_1)>;
            key-positions = <32 31>;
            layers = <0>;
        };

        combo_ctrl_z {
            bindings = <&kp LC(Z)>;
            key-positions = <22 23>;
            require-prior-idle-ms = <100>;
            layers = <0>;
            timeout-ms = <300>;
        };

        combo_ctrl_x {
